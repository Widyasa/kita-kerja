# AI — SERVER-SIDE ONLY
GEMINI_API_KEY=
# Main model for inference. Prefer a stable Flash id (not *-latest aliases).
# Example: gemini-2.5-flash (recommended) or gemma-4-31b-it if list-models confirms it
GEMINI_MODEL=gemini-2.5-flash
# Lightweight model for taxonomy normalization and network/model fallback.
# Example: gemini-2.0-flash-lite
GEMINI_MODEL_LIGHT=gemini-2.0-flash-lite

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application
APP_URL=http://localhost:3000
DEMO_MODE=true

# Demo fallback password for seeded test users (phone auth bypass in DEMO_MODE only)
DEMO_FALLBACK_PASSWORD=kitakerja-demo-2026

# Quota limits
KUOTA_HARIAN_GLOBAL=1400
KUOTA_WAWANCARA_PER_PENGGUNA_HARI=3
KUOTA_AI_PER_PENGGUNA_JAM=20
