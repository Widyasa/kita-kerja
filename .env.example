# AI — SERVER-SIDE ONLY
GEMINI_API_KEY=
# Main model for inference. Chosen from Gemini list-models; supports audio input.
# Example: gemma-4-31b-it (requested) or gemini-2.5-flash (Flash-class audio-capable)
GEMINI_MODEL=gemma-4-31b-it
# Lightweight model for taxonomy normalization and cheap fallback.
# Example: gemini-2.0-flash-lite
GEMINI_MODEL_LIGHT=gemini-2.0-flash-lite

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application
APP_URL=http://localhost:3000
DEMO_MODE=true

# Demo fallback password for seeded test users (phone auth bypass in DEMO_MODE only)
DEMO_FALLBACK_PASSWORD=kitakerja-demo-2026

# Quota limits
KUOTA_HARIAN_GLOBAL=1400
KUOTA_WAWANCARA_PER_PENGGUNA_HARI=3
KUOTA_AI_PER_PENGGUNA_JAM=20
