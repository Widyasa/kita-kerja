# AI — SERVER-SIDE ONLY
GEMINI_API_KEY=
# Main model for inference. Prefer a stable Flash id that ListModels confirms
# for YOUR key (availability varies by key/tier).
# Avoid gemini-2.0-flash / gemini-2.0-flash-lite — shut down 1 Jun 2026.
# Examples that often work: gemini-3.1-flash, gemini-2.5-flash, gemini-flash-latest
GEMINI_MODEL=gemini-3.1-flash
# Lightweight fallback (normalization + retry). Must also be alive for your key.
# Example: gemini-3.1-flash-lite or gemini-2.5-flash-lite
GEMINI_MODEL_LIGHT=gemini-3.1-flash-lite

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application
APP_URL=http://localhost:3000
DEMO_MODE=true

# Demo fallback password for seeded test users (phone auth bypass in DEMO_MODE only)
DEMO_FALLBACK_PASSWORD=kitakerja-demo-2026

# Quota limits
KUOTA_HARIAN_GLOBAL=1400
KUOTA_WAWANCARA_PER_PENGGUNA_HARI=3
KUOTA_AI_PER_PENGGUNA_JAM=20
